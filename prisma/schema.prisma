generator client {
  provider = "prisma-client-js"
}

datasource postgresqlDB {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

model Role {
  id   String @id @default(uuid())
  name String @unique
  user User[]
}

model User {
  id             String   @id @default(uuid())
  idRole         String
  firstName      String
  lastName       String
  email          String   @unique
  username       String   @unique
  password       String
  isActive       Boolean  @default(false)
  token          String?
  favoriteRecipe String[]
  createdAt      DateTime @default(now())
  gdpr           DateTime 
  updatedAt      DateTime @updatedAt
  role           Role     @relation(fields: [idRole], references: [id])
}

model Recipe {
  id              String   @id @default(uuid())
  idUser          String
  title           String
  picture         String
  idCategory      String
  piece           Int
  preparationTime String
  cookingTime     String?
  standingTime    String?
  difficulty      String
  ingredient      String[]
  cookingStep     String[]
  isVisible       Boolean  @default(true)
  category        Category @relation(fields: [idCategory], references: [id])
}

model Category {
  id     String   @id @default(uuid())
  name   String   @unique
  recipe Recipe[]
}
