model Recipe {
  id              String @id @default(uuid())
  idUser          String
  title           String
  picture         String
  idCategory      String
  piece           Int
  preparationTime String
  cookingTime     String?
  standingTime    String?
  difficulty      String
  ingredient      String[]
  cookingStep     String[]
  isVisible       Boolean @default(true)
  // recipeCommentary Recipe_has_Commentary[]
  category Category @relation(fields: [idCategory], references: [id])
}

model Category {
  id    String @id @default(uuid())
  name  String
  recipe Recipe[]
}