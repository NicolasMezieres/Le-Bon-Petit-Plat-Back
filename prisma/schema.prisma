generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRESQL_URL")
}

model Role {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(50)
  user User[]
}

model User {
  id             String   @id @default(uuid())
  idRole         String
  firstName      String   @db.VarChar(50)
  lastName       String   @db.VarChar(50)
  email          String   @unique @db.VarChar(255)
  username       String   @unique @db.VarChar(50)
  password       String   @db.VarChar(255)
  isActive       Boolean  @default(false)
  token          String?
  favoriteRecipe String[]
  createdAt      DateTime @default(now())
  gdpr           DateTime @default(now())
  updatedAt      DateTime @updatedAt
  role           Role     @relation(fields: [idRole], references: [id])
  recipe         Recipe[]
}

model Recipe {
  id              String   @id @default(uuid())
  idUser          String
  title           String   @unique
  picture         String
  idCategory      String
  piece           Int
  preparationTime String
  cookingTime     String?
  standingTime    String?
  difficulty      Int
  ingredient      Ingredient[]
  cookingStep     Json[] 
  note            Decimal  @default(0)
  sumNote         Int      @default(0)
  numberNote      Int      @default(0)
  isVisible       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category        Category @relation(fields: [idCategory], references: [id])
  user            User     @relation(fields: [idUser], references:[id])
}

model Ingredient{
  id          String   @id @default(uuid())
  unit        String
  quantity    Float
  ingredient  String
  idRecipe    String
  recipe  Recipe @relation(fields: [idRecipe], references:[id])
}

model Category {
  id     String   @id @default(uuid())
  name   String   @unique
  recipe Recipe[]
}
